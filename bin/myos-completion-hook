#!/usr/bin/env node
"use strict";
// MyOS automation taskClass: validation.
const fs = require("node:fs");
const {evaluateStopCompletion} = require("../src/orchestration/completion-evidence");
try {
 const payload=JSON.parse(fs.readFileSync(0,"utf8"));
 if (payload.hook_event_name === "Stop" && !payload.stop_hook_active && payload.transcript_path) {
   const fd=fs.openSync(payload.transcript_path,"r");
   let text;
   try {const size=fs.fstatSync(fd).size;const start=Math.max(0,size-1024*1024);const buffer=Buffer.alloc(size-start);fs.readSync(fd,buffer,0,buffer.length,start);text=buffer.toString("utf8");} finally {fs.closeSync(fd);}
   const result=evaluateStopCompletion(payload,text);
   if(result) process.stdout.write(JSON.stringify(result)+"\n");
 }
} catch { /* Missing or unsupported input cannot invent completion evidence. */ }
