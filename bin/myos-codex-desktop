#!/usr/bin/env node
"use strict";

// Operator-invoked recovery only. Never register this as an automation or hook:
// scheduled jobs must retain their unattended identity.
const { execFileSync } = require("node:child_process");
const APP = "/Applications/ChatGPT.app";
const EXECUTABLE = `${APP}/Contents/MacOS/ChatGPT`;

function inspectDesktop(run = execFileSync) {
  const rows = run("/bin/ps", ["-axo", "pid=,comm="], { encoding: "utf8", timeout: 5000 });
  const processes = [];
  for (const line of rows.split("\n")) {
    const match = line.trim().match(/^(\d+)\s+(.+)$/);
    if (!match || match[2] !== EXECUTABLE) continue;
    const pid = Number(match[1]);
    // Never print the environment: it can contain credentials.
    const environment = run("/bin/ps", ["eww", "-p", String(pid), "-o", "command="],
      { encoding: "utf8", timeout: 5000 });
    const marker = environment.match(/(?:^|\s)MYOS_INITIATOR=([^\s]*)/);
    processes.push({ pid, initiator: marker ? marker[1] : null,
      oauthDisabled: /(?:^|\s)MYOS_INITIATOR_OAUTH_DISABLED=1(?:\s|$)/.test(environment) });
  }
  return processes;
}

function launchDesktop({ run = execFileSync, env = process.env } = {}) {
  if (inspectDesktop(run).length) {
    throw new Error("Quit ChatGPT/Codex first after active work is saved. This launcher never stops running sessions.");
  }
  run("/usr/bin/open", ["-a", APP, "--env", "MYOS_INITIATOR=human"], {
    encoding: "utf8", timeout: 10000,
    env: { ...env, MYOS_INITIATOR: "human" },
  });
  return { launchRequested: true, verification: "Run status after the desktop opens; launch acceptance is not verification." };
}

if (require.main === module) {
  try {
    const command = process.argv[2] || "status";
    if (process.platform !== "darwin") throw new Error("This desktop recovery command is macOS-only.");
    if (!["status", "launch"].includes(command) || process.argv.length > 3) {
      throw new Error("Usage: node bin/myos-codex-desktop [status|launch]");
    }
    console.log(JSON.stringify(command === "launch" ? launchDesktop() : { processes: inspectDesktop() }, null, 2));
  } catch (error) {
    console.error(error.message);
    process.exitCode = 1;
  }
}

module.exports = { inspectDesktop, launchDesktop };
